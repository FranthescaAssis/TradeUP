# Copie este arquivo para ".env" (mesma pasta) e preencha. O .env NUNCA vai para o GitHub.

# Conexão com o PostgreSQL:  postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/tradeup

# Segredo que assina o token de login (mínimo 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Endereços do front-end autorizados a falar com a API (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
